{
  "description": "Onboarding at session start: points to /unizo-ctem:unizo-ctem-setup until an environment is picked, then starts both sign-ins automatically after the restart. CTEM guard: blocks ticket moves, requires preview_commit before commit_actions, asks before every unizo-ctem-cloud write, and audits writes to ~/.config/unizo-ctem-mcp/audit.jsonl",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/unizo_ctem_onboard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__unizo-ctem-cloud__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/unizo_ctem_guard.py\" pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__unizo-ctem-cloud__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/unizo_ctem_guard.py\" post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
